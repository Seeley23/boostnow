# BoostNow — Apache/cPanel SPA routing
Options -MultiViews
RewriteEngine On

# Nie przepisywuj istniejących plików i katalogów.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Wszystkie trasy React/Wouter obsługuje index.html.
RewriteRule . /index.html [L]
