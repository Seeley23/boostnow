# BoostNow — Apache/cPanel SPA routing
Options -MultiViews
# Canonicals have no trailing slash; don't let mod_dir 301 /blog/x to /blog/x/.
DirectorySlash Off
RewriteEngine On

# Nie przepisuj istniejących plików.
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Strona główna: prerenderowany index.html (reguła niżej wymaga niepustej ścieżki).
RewriteRule ^$ /index.html [L]

# Strony wyrenderowane statycznie: <trasa>/index.html (scripts/prerender-site.ts).
RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
RewriteRule ^(.+?)/?$ /$1/index.html [L]

# Pozostałe trasy React/Wouter: goła powłoka SPA (bez canonical i bez treści strony głównej).
RewriteRule ^ /spa.html [L]
